#!/bin/sh

echo "🚀 Running pre-commit hooks..."
echo ""

# Get the list of staged files
STAGED_FILES=$(git diff --cached --name-only)

# Check if backend files are staged
BACKEND_STAGED=$(echo "$STAGED_FILES" | grep "^backend/" || true)
# Check if frontend files are staged
FRONTEND_STAGED=$(echo "$STAGED_FILES" | grep "^frontend/" || true)

# Run backend checks if backend files are staged
if [ -n "$BACKEND_STAGED" ]; then
  echo "═══════════════════════════════════════════"
  echo "📦 BACKEND CHECKS"
  echo "═══════════════════════════════════════════"
  
  cd backend
  
  # 1. TypeScript compilation check
  echo ""
  echo "📘 [1/5] TypeScript check..."
  npx tsc --noEmit || exit 1
  
  # 2. Run migrations (check if schema is up to date)
  echo ""
  echo "🗄️  [2/5] Migration check..."
  npm run migration:run 2>/dev/null || echo "⚠️  Migration skipped (no DB connection)"
  
  # 3. Check if migration generated new files (fail if it did)
  echo ""
  echo "📋 [3/5] Checking for uncommitted migration files..."
  MIGRATION_FILES=$(git status --porcelain ../backend/src/database/migrations/ 2>/dev/null | grep "^??" || true)
  if [ -n "$MIGRATION_FILES" ]; then
    echo "❌ Error: New migration files detected but not staged!"
    echo "$MIGRATION_FILES"
    echo "Please run 'npm run migration:generate' and commit the migration files."
    exit 1
  fi
  echo "✓ No new migration files"
  
  # 4. Lint staged files (includes cspell)
  echo ""
  echo "✨ [4/5] Lint & Spell check staged files..."
  npx lint-staged || exit 1
  
  # 5. Run tests
  echo ""
  echo "🧪 [5/5] Running tests..."
  npm run test -- --passWithNoTests --silent || exit 1
  
  cd ..
  echo ""
  echo "✅ Backend checks passed!"
  echo ""
fi

# Run frontend checks if frontend files are staged
if [ -n "$FRONTEND_STAGED" ]; then
  echo "═══════════════════════════════════════════"
  echo "🎨 FRONTEND CHECKS"
  echo "═══════════════════════════════════════════"
  
  cd frontend
  
  # 1. TypeScript check
  echo ""
  echo "📘 [1/2] TypeScript check..."
  npx tsc --noEmit || exit 1
  
  # 2. Lint staged files (includes cspell)
  echo ""
  echo "✨ [2/2] Lint & Spell check staged files..."
  npx lint-staged || exit 1
  
  cd ..
  echo ""
  echo "✅ Frontend checks passed!"
  echo ""
fi

echo "═══════════════════════════════════════════"
echo "🎉 All pre-commit checks passed!"
echo "═══════════════════════════════════════════"
